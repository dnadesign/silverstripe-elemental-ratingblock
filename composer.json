{
    "name": "dnadesign/silverstripe-elemental-ratingblock",
    "description": "Rating block for Business.govt's SilverStripe CMS",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/framework": "^6.0",
        "silverstripe/graphql": "^6.0",
        "silverstripe/vendor-plugin": "^3.0",
        "colymba/gridfield-bulk-editing-tools": "^5.0"
    },
    "require-dev": {
        "silverstripe/cms": "^6.0",
        "silverstripe/graphql-devtools": "dev-master"
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "scripts": {
        "lint": "phpcs -s code/ tests/",
        "lint-clean": "phpcbf code/ tests/"
    },
    "autoload": {
        "psr-4": {
            "DNADesign\\Elemental\\": "code/"
        }
    },
    "config": {
        "process-timeout": 600
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}